{
  "name": "coding-bible",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "action:build": "pnpm --filter @coding-bible/action build",
    "action:check": "pnpm --filter @coding-bible/action build:check",
    "agent:check": "node scripts/generate-agent-interface.mjs --check",
    "agent:generate": "node scripts/generate-agent-interface.mjs",
    "bible:baseline": "node packages/analyzer/bin/coding-bible.mjs baseline create .",
    "bible:bench": "node packages/analyzer/bench/project-benchmark.mjs",
    "bible:check": "node packages/analyzer/bin/coding-bible.mjs check .",
    "bible:staged": "node packages/analyzer/bin/coding-bible.mjs check . --staged",
    "build": "pnpm generate && pnpm build:packages",
    "build:packages": "pnpm -r --filter='!@coding-bible/action' --if-present build",
    "check": "pnpm generate && pnpm lint:fix && pnpm format && pnpm check:verify",
    "check:ci": "pnpm check:verify",
    "check:verify": "pnpm generate:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build:packages && pnpm bible:check",
    "dev": "pnpm --filter @coding-bible/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm registries:generate && pnpm automation:matrix:generate && pnpm rulebook:schema:generate && pnpm agent:generate && pnpm action:build",
    "generate:check": "pnpm registries:check && pnpm automation:matrix:check && pnpm rulebook:schema:check && pnpm agent:check && pnpm action:check",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved --use-tsconfig-files",
    "knip:fast": "knip --dependencies --use-tsconfig-files",
    "lint": "eslint . --cache --cache-location .cache/eslint --max-warnings=0",
    "lint:fix": "eslint . --cache --cache-location .cache/eslint --fix --max-warnings=0",
    "mcp": "node packages/mcp/bin/coding-bible-mcp.mjs",
    "prepare": "husky",
    "precommit": "lint-staged && node scripts/run-precommit.mjs",
    "prepush": "pnpm check:ci",
    "test": "node --test scripts/test/*.test.mjs && pnpm -r --if-present test",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "registries:generate": "node scripts/rules/generate-registries.mjs",
    "registries:check": "node scripts/rules/generate-registries.mjs --check",
    "rule:new": "node scripts/rules/new-rule.mjs",
    "rule:prompt": "node scripts/rules/generate-agent-prompt.mjs",
    "rulebook:new": "node scripts/rules/new-rulebook.mjs",
    "rulebook:validate": "node scripts/rules/validate-rulebook.mjs",
    "rulebook:schema:generate": "node scripts/rules/generate-custom-rulebook-schema.mjs",
    "rulebook:schema:check": "node scripts/rules/generate-custom-rulebook-schema.mjs --check",
    "automation:matrix:generate": "node scripts/rules/generate-automation-matrix.mjs",
    "automation:matrix:check": "node scripts/rules/generate-automation-matrix.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
